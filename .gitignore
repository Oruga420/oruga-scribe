# secrets
.env
.env.local
*.key
*.pem

# the isolated Claude config dir with the personal login lives here, never committed
relay/.claude-home/
relay/scratch/

# generated output
# ANCHORED to the repo root. Unanchored, "out/" also swallows apps/desktop/src/out/,
# core/out/ and anything else a build tool happens to name out, silently and with no error.
/out/
/captures/

# memory harness - HARD RULE: the ARISE harness NEVER goes to GitHub.
# It stays on disk and is rebuilt per machine with /arise. Do not remove these lines.
#
# These four are deliberately left UNANCHORED while the rest of this file is anchored.
# For the harness, over matching is the safe direction: a nested .claude/ that gets ignored
# by accident costs nothing, a nested .claude/ that gets tracked by accident is the exact
# thing the zero tolerance rule exists to prevent.
.arise/
.arise-memory
.mempalace/
.claude/
# The rest of the harness IS anchored, because these names are ordinary enough that a
# subdirectory could legitimately want one and losing it silently would be worse.
/mempalace.yaml
/entities.json
/MEMORY.md.bak
/WIKI.md
/wiki/
/sources/

# NOTE: the per file logbooks (.bitacora/) are NOT listed here on purpose. The engine
# excludes them through .git/info/exclude instead, so enabling them never shows up as a
# tracked change in any repo. Spec: ~/.claude/rules/common/bitacora.md

# node
node_modules/
npm-debug.log*
pnpm-debug.log*

# build artifacts
apps/extension/dist/
apps/desktop/dist/
apps/desktop/target/
apps/desktop/native/target/
*.node
*.zip
*.crx

# os
Thumbs.db
desktop.ini
.DS_Store

# recorded evidence: regenerable with TARGET_URL=... node test/evidence.mjs
# never committed, it contains screenshots and raw step logs of whatever was recorded
/evidence/
/evidence-repro/
/evidence-desktop/
