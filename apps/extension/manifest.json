{
  "manifest_version": 3,
  "name": "oruga-scribe",
  "version": "0.1.0",
  "description": "Records what you click in a web tool and writes the SOP.",
  "minimum_chrome_version": "116",

  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting",
    "webNavigation",
    "tabs"
  ],

  "optional_permissions": ["debugger"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "panel/panel.html"
  },

  "action": {
    "default_title": "oruga-scribe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/capture.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["content/shadow-patch.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
